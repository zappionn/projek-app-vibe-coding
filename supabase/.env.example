# Supabase Edge Functions Secrets (set via: supabase secrets set --env-file supabase/.env)
GEMINI_API_KEY=your_google_ai_studio_api_key
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
CRON_SECRET=replace_with_random_32_char_secret

# Local Auth Google OAuth (for supabase/config.toml local dev if used)
GOOGLE_OAUTH_CLIENT_ID=your_google_web_client_id
GOOGLE_OAUTH_SECRET=your_google_web_client_secret
